rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Only the store owner. No other email, no "verified email" shortcut.
    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'popcarty7@gmail.com';
    }

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Orders: a customer can only create an order for themselves. Only the owner can read or change orders.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isOwner();
    }

    // Reviews: anyone signed in can add one; only the owner can edit or remove.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }
  }
}
