rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // The store owner
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'popcarty7@gmail.com';
    }

    // Dedicated server user. api/create-order, api/verify-payment and api/razorpay-webhook sign in as this user.
    // Create it in Firebase Authentication BEFORE publishing these rules, with a long random password.
    function isShopServer() {
      return isSignedIn() && request.auth.token.email == 'shop-server@popcarty.in';
    }

    function isOrderOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Store settings: owner only (the server may read them to price orders)
    match /settings/{settingId} {
      allow read: if isAdmin() || isShopServer();
      allow write: if isAdmin();
    }

    // Orders are created ONLY by the server after Razorpay confirms the payment.
    // Customers can read their own orders. The owner can read and manage all of them.
    match /orders/{orderId} {
      allow read: if isAdmin() || isShopServer() || isOrderOwner();
      allow create: if isAdmin() || isShopServer();
      allow update, delete: if isAdmin();
    }

    // Unpaid orders waiting for payment. Server only (owner can read and clean up).
    match /pendingOrders/{orderId} {
      allow read: if isAdmin() || isShopServer();
      allow create, update: if isShopServer();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
