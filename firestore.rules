rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    // Strictly authenticate the store admin ('popcarty7@gmail.com')
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'popcarty7@gmail.com';
    }

    // Check if the authenticated user owns the existing order document
    function isOrderOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Validate Order payload when a customer creates their own order
    function isValidNewOrder(orderId) {
      let data = request.resource.data;
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.orderNumber is string &&
             data.orderNumber == orderId &&
             data.customerName is string &&
             data.customerName.size() > 0 &&
             data.customerName.size() <= 200 &&
             data.totalAmount is number &&
             data.totalAmount >= 0 &&
             data.items is list &&
             data.items.size() > 0 &&
             data.shippingAddress is map &&
             data.orderStatus == 'placed' &&
             data.createdAt is string;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Global Settings ('settings' collection)
    // ===============================================================
    match /settings/{settingId} {
      // Strictly restricted to the admin ('popcarty7@gmail.com') for both read and write
      allow read, write: if isAdmin();
    }

    // ===============================================================
    // Orders ('orders' collection)
    // ===============================================================
    match /orders/{orderId} {
      // Private to the order owner (resource.data.userId == request.auth.uid) or the admin
      allow read: if isAdmin() || isOrderOwner();

      // Customers can only create orders tied to their own UID; admin can create any order
      allow create: if isAdmin() || (isSignedIn() && isValidNewOrder(orderId));

      // Only the admin can update order status, tracking, payment status, or delete orders
      allow update, delete: if isAdmin();
    }

    // ===============================================================
    // Catalog & Reviews ('products', 'categories', 'coupons', 'reviews')
    // ===============================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
