rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Only the store owner. No other email, no "verified email" shortcut.
    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'popcarty7@gmail.com';
    }

    // Dedicated server user (api/create-order, api/verify-payment, api/razorpay-webhook sign in as this user).
    // Create it in Firebase Authentication BEFORE publishing these rules, with a long random password.
    function isShopServer() {
      return isSignedIn() && request.auth.token.email == 'shop-server@popcarty.in';
    }

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Orders are created and marked paid ONLY by the server after the payment is verified.
    // A customer can read their own orders. The owner can read and manage all of them.
    match /orders/{orderId} {
      allow create: if isShopServer();
      allow read: if isOwner() || isShopServer() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isOwner() || isShopServer();
      allow delete: if isOwner();
    }

    // Reviews: anyone signed in can add one; only the owner can edit or remove.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isOwner();
    }
  }
}
