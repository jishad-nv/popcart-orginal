{
  "version": 2,
  "functions": {
    "api/fetch-collection.ts": { "maxDuration": 30 }
  },
  "rewrites": [
    {
      "source": "/api/((?!fetch-collection).*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
